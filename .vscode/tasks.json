{
    "tasks": [
        {
            "label": "Kill Running Emulator",
            "type": "shell",
            "command": "taskkill /F /IM chip8_emu.exe 2>nul & taskkill /F /IM cpptools.exe 2>nul || cmd /c exit 0",
            "problemMatcher": []
        },
        
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "dependsOn": [
                "Kill Running Emulator"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}